# Personal logs and exports stay out of the repo; only the fake sample is tracked
*.csv
!sample-data/*.csv
*.pdf
*.png
.DS_Store
!og-image.png
!icons/*.png

# Dev-only test tooling (see tests/, package.json); the app itself has no deps
node_modules/
test-results/
playwright-report/

# Personal Claude Code settings (absolute paths)
.claude/settings.local.json
!docs/*.png
dist/

# Secrets and private data must never be committed (scripts/secret_scan.py enforces this too)
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.env
.env.*
*.pem
*.p12
*.p8
*.pfx
*.key
*.keystore
*.mobileprovision
id_rsa*
id_ed25519*
.npmrc
.netrc
.secret-scan.local
*TirzTrackBackup*
